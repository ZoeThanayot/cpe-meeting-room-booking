# ================= Supabase =================
# เอาค่าจาก Supabase Dashboard → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# publishable key ตัวใหม่ (ขึ้นต้น sb_publishable_...) — ใช้ฝั่ง client ได้ ปลอดภัยเพราะมี RLS
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# (ออปชัน) secret key (ขึ้นต้น sb_secret_...) ใช้เฉพาะฝั่ง server ที่ต้องข้าม RLS
# ดีไซน์นี้ปกติ "ไม่ต้องใช้" เพราะ admin ผ่าน RLS อยู่แล้ว — ถ้าใช้ ห้าม commit และห้ามขึ้นต้น NEXT_PUBLIC_
# SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxx

# หมายเหตุ: ถ้าโปรเจกต์คุณยังโชว์ key แบบเก่า ใช้ anon key แทน publishable ก็ได้ (ยังใช้งานได้ถึงสิ้นปี 2026)
