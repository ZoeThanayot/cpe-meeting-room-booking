# ================= Supabase Configuration =================
# Copy values from Supabase Dashboard → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# New publishable key (starts with sb_publishable_...) — Safe for client-side usage due to RLS
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# (Optional) Service role / secret key (starts with sb_secret_...) — Used on the server-side to bypass RLS
# Typically not required as admins are already handled via RLS policies. Do not prefix with NEXT_PUBLIC_ or commit to git.
# SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxx

# Note: If your project still displays the old key formats, you can use the 'anon key' instead.
